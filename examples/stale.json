{
  "schema_version": 1,
  "name": "synthetic-stale",
  "rules": [
    {
      "name": "first-stale",
      "tool": "ledger.charge",
      "fault": "stale",
      "delay_ms": 0,
      "value": {
        "content": [
          {
            "type": "text",
            "text": "No committed charge in this stale snapshot"
          }
        ],
        "structuredContent": {
          "entry": null
        },
        "isError": false
      }
    }
  ],
  "contracts": {
    "allowed_tools": [
      "ledger.charge",
      "ledger.lookup"
    ],
    "side_effect_tools": [
      "ledger.charge"
    ],
    "require_approval": true,
    "max_retries": 1,
    "max_calls": 3,
    "max_elapsed_ms": 1000
  }
}
