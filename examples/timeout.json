{
  "schema_version": 1,
  "name": "synthetic-timeout",
  "rules": [
    {
      "name": "first-timeout",
      "tool": "ledger.charge",
      "fault": "timeout",
      "delay_ms": 100
    }
  ],
  "contracts": {
    "allowed_tools": [
      "ledger.charge",
      "ledger.lookup"
    ],
    "side_effect_tools": [
      "ledger.charge"
    ],
    "require_approval": true,
    "max_retries": 1,
    "max_calls": 3,
    "max_elapsed_ms": 1000
  }
}
